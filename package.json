{
  "name": "nyx-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nyx-ui/plugins build && pnpm --filter @nyx-ui/docs dev --host 127.0.0.1",
    "build": "pnpm --filter @nyx-ui/plugins build && pnpm --filter @nyx-ui/docs build",
    "test": "pnpm --filter @nyx-ui/plugins test",
    "typecheck": "pnpm --filter @nyx-ui/plugins build && pnpm -r typecheck",
    "packages:check": "node scripts/verify-packages.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm packages:check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
