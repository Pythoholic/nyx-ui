{
  "name": "nyx-ui",
  "version": "0.2.0-beta.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nyx-raul/plugins build && pnpm --filter @nyx-raul/docs dev --host 127.0.0.1 --port 5174 --strictPort",
    "mcp:build": "pnpm --filter @nyx-raul/mcp build",
    "mcp:serve": "node packages/mcp/dist/cli.js",
    "build": "pnpm --filter @nyx-raul/mcp build && pnpm --filter @nyx-raul/plugins build && pnpm --filter @nyx-raul/docs build && pnpm --filter @nyx-raul/workspace-example build",
    "test": "pnpm test:unit && pnpm test:browser",
    "test:ci": "pnpm test",
    "test:unit": "pnpm --filter @nyx-raul/mcp test && pnpm --filter @nyx-raul/plugins test",
    "test:browser": "pnpm --filter @nyx-raul/plugins build && playwright test",
    "typecheck": "pnpm --filter @nyx-raul/plugins build && pnpm -r typecheck",
    "packages:check": "node scripts/verify-packages.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node -e \"console.error('Publishing is disabled locally. Use the protected GitHub release workflow.'); process.exit(1)\""
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "1.63.0"
  }
}
