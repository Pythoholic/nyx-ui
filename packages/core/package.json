{
  "name": "@nyx-raul/core",
  "version": "0.2.0-beta.1",
  "description": "Nyx UI tokens, themes, foundations, and component styles.",
  "keywords": ["nyx-ui", "tailwindcss", "design-system", "css"],
  "license": "Apache-2.0",
  "author": "Soumya Raula <boxitupsam@gmail.com>",
  "type": "module",
  "homepage": "https://github.com/Pythoholic/nyx-ui#readme",
  "bugs": "https://github.com/Pythoholic/nyx-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pythoholic/nyx-ui.git",
    "directory": "packages/core"
  },
  "style": "./src/index.css",
  "exports": {
    ".": "./src/index.css",
    "./theme.css": "./src/index.css"
  },
  "files": ["src/**/*.css", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "peerDependencies": {
    "tailwindcss": ">=4 <5"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
